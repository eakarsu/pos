# PostgreSQL database prepared for this application
DATABASE_URL="postgresql://pos_user:replace-me@127.0.0.1:5432/pos_system?schema=public"

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET="generate-a-unique-random-value-of-at-least-32-characters"
JWT_REFRESH_SECRET="generate-a-different-random-value-of-at-least-32-characters"

# Server Configuration
PORT=3041
NODE_ENV=production
API_VERSION=1

# CORS Configuration
CORS_ORIGIN="http://127.0.0.1:5181"

# Controlled store operations. Keep disabled until an approved provider/hardware stack is configured.
PAYMENT_PROVIDER="disabled"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
DEVICE_CREDENTIAL_HMAC_KEY="generate-a-distinct-random-value-of-at-least-32-characters"
GIFT_CARD_HMAC_KEY="generate-another-distinct-random-value-of-at-least-32-characters"
OFFLINE_CASH_LIMIT_CENTS="20000"
OFFLINE_MAX_AGE_MINUTES="1440"
CASH_VARIANCE_APPROVAL_CENTS="500"
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
