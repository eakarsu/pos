# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pos_system?schema=public"

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET="pos-system-super-secret-jwt-key-2024"
JWT_REFRESH_SECRET="pos-system-super-secret-refresh-key-2024"

# Server Configuration
PORT=3000
NODE_ENV="development"
API_VERSION="1"

# CORS Configuration
CORS_ORIGIN="http://localhost:5173"

# Optional Services (can be left as-is for development)
REDIS_URL="redis://localhost:6379"
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Email Configuration (optional for development)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
FROM_EMAIL="noreply@yourdomain.com"

# Business Settings
DEFAULT_TAX_RATE=0.08
DEFAULT_CURRENCY="USD"
BUSINESS_NAME="POS System Store"
BUSINESS_ADDRESS="123 Main St, City, State 12345"
BUSINESS_PHONE="+1-555-123-4567"
BUSINESS_EMAIL="info@possystem.com"

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH="./uploads"

# Logging
LOG_LEVEL="info"
LOG_FILE="logs/pos-system.log"
