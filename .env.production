# Production Environment Configuration
# Copy this file to .env and update the values for your production deployment

# Database - PostgreSQL for production
DATABASE_URL="postgresql://postgres:your-secure-password@localhost:5432/pos_system?schema=public"

# JWT Secrets - GENERATE NEW SECURE KEYS FOR PRODUCTION!
JWT_SECRET="CHANGE-THIS-TO-A-SECURE-64-CHARACTER-RANDOM-STRING"
JWT_REFRESH_SECRET="CHANGE-THIS-TO-ANOTHER-SECURE-64-CHARACTER-RANDOM-STRING"

# Server Configuration
PORT=3000
NODE_ENV=production
API_VERSION=1

# CORS Configuration - Update with your frontend domain
CORS_ORIGIN="https://your-frontend-domain.com"

# Logging Configuration
LOG_LEVEL=warn
LOG_FORMAT=json

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Rate Limiting - Stricter for production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50

# Session Configuration
SESSION_TIMEOUT=1800000

# Email Configuration (configure for production notifications)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-email@your-domain.com
SMTP_PASS=your-secure-app-password
FROM_EMAIL=noreply@your-domain.com

# Backup Configuration
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# Security Headers
HELMET_ENABLED=true
TRUST_PROXY=true
