// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Management
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  username    String   @unique
  firstName   String
  lastName    String
  password    String
  role        String   @default("CASHIER") // ADMIN, MANAGER, CASHIER, CUSTOMER
  isActive    Boolean  @default(true)
  lastLogin   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Employee specific fields
  employeeId  String?  @unique
  phone       String?
  address     String?
  hireDate    DateTime?
  salary      Float?
  commission  Float?   @default(0)

  // Password reset
  passwordResetToken    String?   @unique
  passwordResetExpires  DateTime?

  // Email verification
  emailVerified          Boolean   @default(false)
  emailVerificationToken String?   @unique

  // Relations
  sales       Sale[]
  shifts      Shift[]
  auditLogs   AuditLog[]
  refreshTokens RefreshToken[]
  inventoryMovements InventoryMovement[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// Customer Management
model Customer {
  id          String   @id @default(cuid())
  email       String?  @unique
  phone       String?  @unique
  firstName   String
  lastName    String
  dateOfBirth DateTime?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  loyaltyPoints Int    @default(0)
  totalSpent  Float    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  sales       Sale[]
  loyaltyTransactions LoyaltyTransaction[]

  @@map("customers")
}

// Product Management
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  products    Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  sku         String   @unique
  barcode     String?  @unique
  price       Float
  cost        Float    @default(0)
  taxRate     Float    @default(0)
  isActive    Boolean  @default(true)
  isWeighed   Boolean  @default(false)
  minStock    Int      @default(0)
  maxStock    Int?
  reorderPoint Int     @default(0)
  categoryId  String?
  supplierId  String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  category    Category? @relation(fields: [categoryId], references: [id])
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  variants    ProductVariant[]
  inventory   InventoryItem[]
  saleItems   SaleItem[]

  @@map("products")
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  name      String   // e.g., "Size", "Color"
  value     String   // e.g., "Large", "Red"
  sku       String   @unique
  barcode   String?  @unique
  price     Float?
  cost      Float?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory InventoryItem[]
  saleItems SaleItem[]

  @@map("product_variants")
}

// Supplier Management
model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  products    Product[]

  @@map("suppliers")
}

// Inventory Management
model InventoryItem {
  id              String   @id @default(cuid())
  productId       String?
  variantId       String?
  quantity        Int      @default(0)
  reservedQty     Int      @default(0)
  location        String?
  batchNumber     String?
  expirationDate  DateTime?
  lastUpdated     DateTime @default(now())
  createdAt       DateTime @default(now())

  // Relations
  product         Product? @relation(fields: [productId], references: [id])
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  movements       InventoryMovement[]

  @@unique([productId, variantId, batchNumber])
  @@map("inventory_items")
}

model InventoryMovement {
  id            String   @id @default(cuid())
  inventoryId   String
  type          String   // IN, OUT, ADJUSTMENT, TRANSFER
  quantity      Int
  reason        String?
  referenceId   String?  // Sale ID, Purchase Order ID, etc.
  userId        String?
  createdAt     DateTime @default(now())

  // Relations
  inventory     InventoryItem @relation(fields: [inventoryId], references: [id])
  user          User?         @relation(fields: [userId], references: [id])

  @@map("inventory_movements")
}

// Sales Management
model Sale {
  id            String   @id @default(cuid())
  saleNumber    String   @unique
  customerId    String?
  userId        String
  subtotal      Float
  taxAmount     Float
  discountAmount Float   @default(0)
  totalAmount   Float
  status        String   @default("COMPLETED") // DRAFT, COMPLETED, CANCELLED, REFUNDED
  paymentStatus String   @default("PAID") // PENDING, PAID, FAILED, REFUNDED, PARTIALLY_PAID
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  customer      Customer? @relation(fields: [customerId], references: [id])
  user          User      @relation(fields: [userId], references: [id])
  items         SaleItem[]
  payments      Payment[]
  returns       Return[]

  @@map("sales")
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  productId   String?
  variantId   String?
  quantity    Float
  unitPrice   Float
  discount    Float    @default(0)
  taxRate     Float    @default(0)
  totalPrice  Float
  createdAt   DateTime @default(now())

  // Relations
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("sale_items")
}

// Payment Management
model Payment {
  id            String   @id @default(cuid())
  saleId        String?
  amount        Float
  method        String   // CASH, CREDIT_CARD, DEBIT_CARD, MOBILE_PAYMENT, GIFT_CARD, STORE_CREDIT, CHECK
  status        String   @default("PENDING") // PENDING, PAID, FAILED, REFUNDED, PARTIALLY_PAID
  reference     String?  // Transaction ID, check number, etc.
  stripePaymentId String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  sale          Sale?    @relation(fields: [saleId], references: [id])

  @@map("payments")
}

// Returns Management
model Return {
  id          String   @id @default(cuid())
  saleId      String
  reason      String
  totalAmount Float
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED
  processedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  sale        Sale         @relation(fields: [saleId], references: [id])
  items       ReturnItem[]

  @@map("returns")
}

model ReturnItem {
  id          String   @id @default(cuid())
  returnId    String
  productId   String?
  variantId   String?
  quantity    Float
  unitPrice   Float
  totalPrice  Float
  createdAt   DateTime @default(now())

  // Relations
  return      Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@map("return_items")
}

// Loyalty System
model LoyaltyTransaction {
  id          String   @id @default(cuid())
  customerId  String
  points      Int
  type        String   // EARNED, REDEEMED, EXPIRED, ADJUSTMENT
  description String?
  referenceId String?  // Sale ID or other reference
  createdAt   DateTime @default(now())

  // Relations
  customer    Customer @relation(fields: [customerId], references: [id])

  @@map("loyalty_transactions")
}

// Employee Management
model Shift {
  id        String    @id @default(cuid())
  userId    String
  startTime DateTime
  endTime   DateTime?
  breakTime Int       @default(0) // minutes
  totalHours Float?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  user      User      @relation(fields: [userId], references: [id])

  @@map("shifts")
}

// System Management
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  tableName   String?
  recordId    String?
  oldValues   String?  // JSON as string
  newValues   String?  // JSON as string
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  // Relations
  user        User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("string")
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model AiInsight {
  id          String   @id @default(cuid())
  type        String   // "sales", "inventory", "customers"
  payload     String   // JSON string of the full AI response
  generatedAt DateTime @default(now())

  @@map("ai_insights")
}

/// Generic AI results store — JSONB input + output for any AI feature.
/// Used by copilot, reorder agent, elasticity, fraud scoring, etc.
model AiResult {
  id          String   @id @default(cuid())
  feature     String   // "copilot", "reorder", "elasticity", "fraud", etc.
  userId      String?
  input       Json
  output      Json
  model       String?
  tokensUsed  Int?
  durationMs  Int?
  status      String   @default("success") // success | error
  errorMessage String?
  createdAt   DateTime @default(now())

  @@index([feature, createdAt])
  @@index([userId, createdAt])
  @@map("ai_results")
}

